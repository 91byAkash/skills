  },
  "radius": {
    "sm": { "$value": {"value": 4, "unit": "px"}, "$type": "dimension" },
    "md": { "$value": {"value": 8, "unit": "px"}, "$type": "dimension" },
    "lg": { "$value": {"value": 12, "unit": "px"}, "$type": "dimension" },
    "full": { "$value": {"value": 9999, "unit": "px"}, "$type": "dimension" }
  },
  "font": {
    "sans": {
      "$value": "\"Your Sans\", ui-sans-serif, system-ui, sans-serif",
      "$type": "fontFamily"
    },
    "mono": { "$value": "ui-monospace, Menlo, monospace", "$type": "fontFamily" }
  },
  "duration": {
    "fast": { "$value": {"value": 120, "unit": "ms"}, "$type": "duration" },
    "base": { "$value": {"value": 200, "unit": "ms"}, "$type": "duration" }
  },
  "z": {
    "dropdown": { "$value": 1000, "$type": "number" },
    "sticky": { "$value": 1100, "$type": "number" },
    "overlay": { "$value": 1200, "$type": "number" },
    "modal": { "$value": 1300, "$type": "number" },
    "toast": { "$value": 1500, "$type": "number" }
  },
  "themes": {
    "light": {
      "color": {
        "bg": { "$value": "{gray.50}" },
        "surface": { "$value": "{white}" },
        "text": { "$value": "{gray.900}" },
        "text-muted": { "$value": "{gray.600}" },
        "border": { "$value": "{gray.500}" },
        "accent": { "$value": "{teal.700}" },
        "accent-text": { "$value": "{white}" },
        "danger": { "$value": "{red.700}" },
        "focus": { "$value": "{teal.600}" }
      }
    },
    "dark": {
      "color": {
        "bg": { "$value": "{gray.950}" },
        "surface": { "$value": "{gray.900}" },
        "text": { "$value": "{gray.50}" },
        "text-muted": { "$value": "{gray.300}" },
        "border": { "$value": "{gray.500}" },
        "accent": { "$value": "{teal.400}" },
        "accent-text": { "$value": "{gray.950}" },
        "danger": { "$value": "{red.400}" },
        "focus": { "$value": "{teal.300}" }
      }
    }
  },
  "component": {
    "button-primary-bg": { "$value": "{color.accent}" },
    "button-primary-text": { "$value": "{color.accent-text}" }
  },
  "contrast_pairs": [
    { "fg": "color.text", "bg": "color.bg", "min": 4.5 },
    { "fg": "color.text", "bg": "color.surface", "min": 4.5 },
    { "fg": "color.text-muted", "bg": "color.surface", "min": 4.5 },
    { "fg": "color.accent-text", "bg": "color.accent", "min": 4.5 },
    { "fg": "color.danger", "bg": "color.surface", "min": 4.5 },
    { "fg": "color.border", "bg": "color.surface", "min": 3.0 },
    { "fg": "color.focus", "bg": "color.bg", "min": 3.0 }
  ]
}
